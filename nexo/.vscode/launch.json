{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Depurar NEXO (sin pedir administrador)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/target/debug/nexo.exe",
      "args": [],
      "cwd": "${workspaceFolder}",
      "environment": [{ "name": "NEXO_SIN_ELEVAR", "value": "1" }],
      "console": "internalConsole",
      "preLaunchTask": "NEXO: compilar (depuración)"
    },
    {
      "name": "Depurar NEXO en una página (Limpieza)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/target/debug/nexo.exe",
      "args": ["--pagina", "limpieza"],
      "cwd": "${workspaceFolder}",
      "environment": [{ "name": "NEXO_SIN_ELEVAR", "value": "1" }],
      "console": "internalConsole",
      "preLaunchTask": "NEXO: compilar (depuración)"
    },
    {
      "name": "Depurar el vigía (bandeja)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/target/debug/nexo.exe",
      "args": ["--vigia"],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "preLaunchTask": "NEXO: compilar (depuración)"
    }
  ]
}
